/* ============================== BIND EVENTS ============================== */
function bindShell(){
  const logout = document.getElementById("btn-logout");
  if(logout) logout.onclick = async ()=>{
    await supabaseClient.auth.signOut();
  };
  document.querySelectorAll("[data-nav]").forEach(el=>{
    el.onclick = ()=>{ ui.view = el.getAttribute("data-nav"); ui.search=""; ui.clientModal=null; ui.addOpen=false; ui.mobileNavOpen=false; render(); };
  });
  const hb = document.getElementById("btn-hamburger");
  if(hb) hb.onclick = ()=>{ ui.mobileNavOpen = !ui.mobileNavOpen; render(); };
  const cb = document.getElementById("btn-collapse");
  if(cb) cb.onclick = async ()=>{ DB.settings.sidebarCollapsed = !DB.settings.sidebarCollapsed; await persist(); render(); };
  document.querySelectorAll("[data-theme-mode]").forEach(el=>{
    el.onclick = async ()=>{ DB.settings.themeMode = el.getAttribute("data-theme-mode"); await persist(); render(); };
  });
  const gs = document.getElementById("global-search");
  if(gs) gs.oninput = (e)=>{ ui.search = e.target.value; render(); const el=document.getElementById("global-search"); if(el){ el.focus(); el.selectionStart = el.value.length; } };

  const ppSave = document.getElementById("profile-name-save");
  if(ppSave) ppSave.onclick = async ()=>{
    const v = document.getElementById("profile-name-inline").value.trim();
    if(!v) return;
    DB.settings.profile = { name:v, initials:initialsFor(v) };
    const { error } = await supabaseClient.auth.updateUser({ data:{ name:v, initials:initialsFor(v) } });
    if(error){ alert("Could not update your account name: " + error.message); return; }
    ui.needsProfilePrompt = false;
    await persist(); render();
  };

  document.querySelectorAll("[data-open]").forEach(el=>{
    el.onclick = ()=>{ ui.clientModal = el.getAttribute("data-open"); ui.clientTab="overview"; render(); };
  });
  document.querySelectorAll("[data-acc]").forEach(el=>{
    el.onclick = ()=>{ const idx = Number(el.getAttribute("data-acc")); ui.openAccordion = ui.openAccordion===idx ? null : idx; render(); };
  });

  if(ui.view==="active" || ui.view==="archived") bindCaseList(ui.view==="archived");
  if(ui.view==="import") bindImport();
  if(ui.view==="settings") bindSettings();
  if(ui.addOpen) bindAddModal();
  if(ui.clientModal) bindClientModal();
}

function bindCaseList(archivedView){
  const sf = document.getElementById("status-filter"); if(sf) sf.onchange = (e)=>{ ui.statusFilter = e.target.value==="All statuses"?"All":e.target.value; render(); };
  const cf = document.getElementById("county-filter"); if(cf) cf.onchange = (e)=>{ ui.countyFilter = e.target.value; render(); };
  const crf = document.getElementById("creator-filter"); if(crf) crf.onchange = (e)=>{ ui.creatorFilter = e.target.value; render(); };
  const sb = document.getElementById("sort-by"); if(sb) sb.onchange = (e)=>{ ui.sortBy = e.target.value; render(); };
  const clr = document.getElementById("clear-filters"); if(clr) clr.onclick = ()=>{ ui.statusFilter="All"; ui.countyFilter="All"; ui.creatorFilter="All"; render(); };
  const add = document.getElementById("btn-add"); if(add) add.onclick = ()=>{ ui.addOpen = true; render(); };
}

function bindAddModal(){
  document.getElementById("add-close").onclick = ()=>{ ui.addOpen=false; render(); };
  document.getElementById("add-backdrop").onclick = (e)=>{ if(e.target.id==="add-backdrop"){ ui.addOpen=false; render(); } };
  document.getElementById("add-submit").onclick = async ()=>{
    const name = document.getElementById("f-name").value.trim();
    if(!name){ document.getElementById("add-error").textContent = "Enter a name first."; return; }
    const tags = document.getElementById("f-tags").value.split(",").map(t=>t.trim()).filter(Boolean);
    await addClient({
      name, county: document.getElementById("f-county").value,
      fundType: document.getElementById("f-fundtype").value,
      amount: document.getElementById("f-amount").value,
      phone: document.getElementById("f-phone").value,
      email: document.getElementById("f-email").value,
      sourceUrl: document.getElementById("f-source").value,
      notes: document.getElementById("f-notes").value,
      status: "New lead", tags
    });
    ui.addOpen = false; ui.view="active"; render();
  };
}

function bindClientModal(){
  const id = ui.clientModal;
  const backdrop = document.getElementById("client-backdrop");
  document.getElementById("client-close").onclick = ()=>{ ui.clientModal=null; render(); };
  backdrop.onclick = (e)=>{ if(e.target.id==="client-backdrop"){ ui.clientModal=null; render(); } };
  document.querySelectorAll("[data-tab]").forEach(btn=>{ btn.onclick = ()=>{ ui.clientTab = btn.getAttribute("data-tab"); render(); }; });

  document.querySelectorAll("[data-fu]").forEach(btn=>{
    btn.onclick = async ()=>{ const days = Number(btn.getAttribute("data-fu")); await updateClient(id, { nextFollowUp: addDays(todayStr(), days) }); ui.clientModal = id; render(); };
  });
  document.querySelectorAll("[data-log]").forEach(btn=>{
    btn.onclick = async ()=>{
      const c = DB.clients.find(x=>x.id===id);
      const fud = btn.getAttribute("data-fudays");
      await logActivity(c, btn.getAttribute("data-log"), btn.getAttribute("data-advance"), fud ? Number(fud) : null);
      ui.clientModal = id; render();
    };
  });
  document.querySelectorAll("[data-rmfile]").forEach(btn=>{
    btn.onclick = async ()=>{ const c = DB.clients.find(x=>x.id===id); await removeFileRef(c, Number(btn.getAttribute("data-rmfile"))); ui.clientModal=id; render(); };
  });
  const addFileBtn = document.getElementById("btn-addfile");
  if(addFileBtn) addFileBtn.onclick = async ()=>{
    const name = document.getElementById("nf-name").value.trim();
    if(!name) return;
    const c = DB.clients.find(x=>x.id===id);
    await addFileRef(c, { name, category: document.getElementById("nf-cat").value, note: document.getElementById("nf-note").value });
    ui.clientModal = id; render();
  };

  const saveBtn = document.getElementById("client-save");
  if(saveBtn) saveBtn.onclick = async ()=>{
    const patch = {};
    const grab = (elId)=>{ const el=document.getElementById(elId); return el?el.value:undefined; };
    if(document.getElementById("e-name")) patch.name = grab("e-name");
    if(document.getElementById("e-status")) patch.status = grab("e-status");
    if(document.getElementById("e-county")){ const county=grab("e-county"); patch.county=county; patch.state=stateFromCounty(county); }
    if(document.getElementById("e-fundtype")) patch.fundType = grab("e-fundtype");
    if(document.getElementById("e-phone")) patch.phone = grab("e-phone");
    if(document.getElementById("e-email")) patch.email = grab("e-email");
    if(document.getElementById("e-source")) patch.sourceUrl = grab("e-source");
    if(document.getElementById("e-tags")) patch.tags = grab("e-tags").split(",").map(t=>t.trim()).filter(Boolean);
    if(document.getElementById("e-followup")) patch.nextFollowUp = grab("e-followup");
    if(document.getElementById("e-amount")) patch.amount = grab("e-amount");
    if(document.getElementById("e-companypct")) patch.companyPct = grab("e-companypct");
    if(document.getElementById("e-clientpct")) patch.clientPct = grab("e-clientpct");
    if(document.getElementById("e-attorneypct")) patch.attorneyPct = grab("e-attorneypct");
    if(document.getElementById("e-expenses")) patch.expenses = grab("e-expenses");
    if(document.getElementById("e-fees")) patch.fees = grab("e-fees");
    if(document.getElementById("e-actualrecovery")) patch.actualRecovery = grab("e-actualrecovery");
    if(document.getElementById("e-notes")) patch.notes = grab("e-notes");
    await updateClient(id, patch);
    ui.clientModal = null; render();
  };
  const archiveBtn = document.getElementById("client-archive");
  if(archiveBtn) archiveBtn.onclick = async ()=>{ await archiveClient(id, true); ui.clientModal=null; render(); };
  const restoreBtn = document.getElementById("client-restore");
  if(restoreBtn) restoreBtn.onclick = async ()=>{ await archiveClient(id, false); ui.clientModal=null; render(); };
  document.getElementById("client-delete").onclick = async ()=>{
    if(confirm("Permanently delete this case file? This can't be undone — consider Archive instead if you just want it out of the active list.")) await deleteClient(id);
  };
}

function bindImport(){
  document.getElementById("csv-file").onchange = (e)=>{
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = (ev)=>{ document.getElementById("csv-paste").value = ev.target.result; };
    reader.readAsText(file);
  };
  document.getElementById("csv-preview-btn").onclick = ()=>{
    const text = document.getElementById("csv-paste").value;
    const rows = parseCSV(text);
    if(!rows.length){ alert("No valid rows found — make sure the first row has headers and at least a 'name' column."); return; }
    ui.importRows = rows; render();
  };
  const importBtn = document.getElementById("csv-import-btn");
  if(importBtn) importBtn.onclick = ()=> bulkImport(ui.importRows);
}

function bindSettings(){
  const pName = document.getElementById("profile-save");
  if(pName) pName.onclick = async ()=>{
    const v = document.getElementById("profile-name").value.trim();
    DB.settings.profile = { name:v, initials:initialsFor(v) };
    if(v){
      const { error } = await supabaseClient.auth.updateUser({ data:{ name:v, initials:initialsFor(v) } });
      if(error){ alert("Could not update your account name: " + error.message); return; }
    }
    ui.needsProfilePrompt = !v;
    await persist(); render();
  };
  const accentApply = document.getElementById("accent-apply");
  if(accentApply) accentApply.onclick = async ()=>{ DB.settings.themeCustom = { accent: document.getElementById("c-accent").value }; await persist(); render(); };
  const accentReset = document.getElementById("accent-reset");
  if(accentReset) accentReset.onclick = async ()=>{ DB.settings.themeCustom = null; await persist(); render(); };
  const financeSave = document.getElementById("finance-save");
  if(financeSave) financeSave.onclick = async ()=>{ DB.settings.finance.defaultCompanyPct = Number(document.getElementById("finance-default-pct").value)||0; await persist(); render(); };

  document.getElementById("btn-export").onclick = ()=>{
    const blob = new Blob([JSON.stringify(DB, null, 2)], {type:"application/json"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob); a.download = "overage-registry-backup.json"; a.click();
    URL.revokeObjectURL(a.href);
  };
  document.getElementById("btn-import").onchange = (e)=>{
    const file = e.target.files[0]; if(!file) return;
    const reader = new FileReader();
    reader.onload = async (ev)=>{
      try{
        const data = JSON.parse(ev.target.result);
        if(!data.clients) throw new Error("bad file");
        DB.clients = data.clients;
        if(data.settings) DB.settings = Object.assign(defaultSettings(), data.settings, { profile: Object.assign({name:"",initials:""}, (data.settings||{}).profile||{}) });
        await persist(); render();
      }catch(err){ alert("That file isn't a valid Overage Registry backup."); }
    };
    reader.readAsText(file);
  };

  const settingsLogout = document.getElementById("settings-logout");
  if(settingsLogout) settingsLogout.onclick = async ()=>{
    await supabaseClient.auth.signOut();
  };
}

/* ============================== BOOT ============================== */
(async function boot(){
  try{
    const { data } = await supabaseClient.auth.getSession();
    AUTH_SESSION = data.session || null;
  }catch(e){
    console.error("Supabase session check failed:", e);
    authError = "Could not connect to Supabase. Check your project URL/key.";
  }

  AUTH_READY = true;
  ui.loading = false;
  render();

  supabaseClient.auth.onAuthStateChange(async (_event, session)=>{
    AUTH_SESSION = session || null;

    if(AUTH_SESSION){
      await finishAuthenticatedBoot();
    }else{
      stopCloudPoll();
      DB = { clients: [], settings: defaultSettings() };
      ui = { view:"dashboard", clientModal:null, clientTab:"overview", addOpen:false, search:"", statusFilter:"All",
        countyFilter:"All", creatorFilter:"All", sortBy:"dateAdded", importRows:null, loading:false, saving:false,
        teamError:"", mobileNavOpen:false, openAccordion:null, needsProfilePrompt:false };
      render();
    }
  });
})();
</script>
</body>
</html>
