  </div>`).join("")}`;
}

/* ---------- Reports ---------- */
function renderReports(){
  const byCreator = {};
  DB.clients.forEach(c=>{
    const k = c.createdBy||"Unassigned";
    if(!byCreator[k]) byCreator[k] = { cases:0, potential:0, actual:0 };
    const f = calcFinancials(c);
    byCreator[k].cases++; byCreator[k].potential += f.est;
    if(f.actualProfit!=null) byCreator[k].actual += f.actualProfit;
  });
  return `
  <div class="eyebrow">Analytics</div>
  <h1 class="title">Reports</h1>
  <div class="grid2">
    <div class="chartbox"><div class="eyebrow">Profit over time (actual, by month paid)</div><canvas id="chart-profit"></canvas></div>
    <div class="chartbox"><div class="eyebrow">Profit by county (estimated)</div><canvas id="chart-county"></canvas></div>
  </div>
  <div class="card">
    <h3>Cases by creator</h3>
    <table><thead><tr><th>Created by</th><th>Cases</th><th>Potential recovery</th><th>Actual profit</th></tr></thead>
    <tbody>${Object.entries(byCreator).map(([k,v])=>`<tr><td style="font-weight:600;">${escapeHtml(k)}</td><td>${v.cases}</td><td style="font-family:var(--font-mono);">${currency(v.potential)}</td><td style="font-family:var(--font-mono);">${currency(v.actual)}</td></tr>`).join("") || `<tr><td colspan="4" class="subtle">No cases yet.</td></tr>`}</tbody></table>
  </div>`;
}
function drawReportsCharts(){
  if(typeof Chart==="undefined") return;
  const profitCanvas = document.getElementById("chart-profit");
  const countyCanvas = document.getElementById("chart-county");
  if(profitCanvas){
    destroyChart("profit");
    const months = [];
    for(let i=5;i>=0;i--){ const d=new Date(); d.setMonth(d.getMonth()-i); months.push(d); }
    const labels = months.map(d=>d.toLocaleString("en-US",{month:"short"}));
    const values = months.map(d=>{
      const ym = d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0");
      return DB.clients.filter(c=>c.archived && (c.archivedDate||"").startsWith(ym)).reduce((s,c)=>s+(calcFinancials(c).actualProfit||0),0);
    });
    charts.profit = new Chart(profitCanvas, { type:"line", data:{ labels, datasets:[{ data:values, borderColor:"#5B8CFF", backgroundColor:"#5B8CFF33", fill:true, tension:.3, pointRadius:3 }] }, options: baseChartOpts(false) });
  }
  if(countyCanvas){
    destroyChart("county");
    const byCounty = {};
    DB.clients.forEach(c=>{ if(!c.county) return; byCounty[c.county] = (byCounty[c.county]||0) + calcFinancials(c).estimatedProfit; });
    const entries = Object.entries(byCounty).sort((a,b)=>b[1]-a[1]).slice(0,8);
    charts.county = new Chart(countyCanvas, { type:"bar", data:{ labels: entries.map(e=>e[0].replace(", GA","")), datasets:[{ data: entries.map(e=>e[1]), backgroundColor:"#2FBF71", borderRadius:4 }] }, options: Object.assign(baseChartOpts(false), { indexAxis:"y" }) });
  }
}

