let AUTH_SESSION = null;
let AUTH_READY = false;
let authMode = "login";
let authMessage = "";
let authError = "";

function authUser(){ return AUTH_SESSION ? AUTH_SESSION.user : null; }
function currentUserName(){
  const u = authUser();
  const metadataName = u && u.user_metadata ? (u.user_metadata.name || "") : "";
  return metadataName || DB.settings.profile.name || (u && u.email ? u.email.split("@")[0] : "Unassigned");
}
function currentUserEmail(){ return authUser() && authUser().email ? authUser().email : ""; }

