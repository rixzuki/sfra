function countyByName(name){ return COUNTIES.find(c=>c.name===name); }

function defaultSettings(){
  return {
    themeMode:"dark", themeCustom:null,
    profile: { name:"", initials:"" },
      finance: { defaultCompanyPct: 30 },
    sidebarCollapsed:false
  };
}
let DB = { clients: [], settings: defaultSettings() };
let ui = { view:"dashboard", clientModal:null, clientTab:"overview", addOpen:false, search:"", statusFilter:"All",
  countyFilter:"All", creatorFilter:"All", sortBy:"dateAdded", importRows:null, loading:true, saving:false,
  teamError:"", mobileNavOpen:false, openAccordion:null, needsProfilePrompt:false };
let pollHandle = null;
let charts = {};

/* ============================== STORAGE / CLOUD ============================== */
async function loadDB(){
  if(!AUTH_SESSION) return;

  // Load per-user settings so theme/profile follow the user across devices.
  const { data: settingsRow, error: settingsError } = await supabaseClient
    .from("user_settings")
    .select("data")
    .eq("user_id", AUTH_SESSION.user.id)
    .maybeSingle();

  if(settingsError) console.warn("Could not load user settings:", settingsError.message);

  if(settingsRow && settingsRow.data){
    try{
      DB.settings = Object.assign(
        defaultSettings(),
        settingsRow.data,
        { profile: Object.assign({name:"",initials:""}, settingsRow.data.profile || {}) }
      );
    }catch(e){}
  }

  // Load the shared registry. Every authenticated user can work in the same registry.
  const { data: registryRow, error: registryError } = await supabaseClient
    .from("registry_data")
    .select("clients")
    .eq("id", 1)
    .maybeSingle();

  if(registryError){
    ui.teamError = "Could not load the shared registry. Check your Supabase table/RLS setup.";
    console.error(registryError);
  } else if(registryRow && Array.isArray(registryRow.clients)){
    DB.clients = registryRow.clients;
  } else {
    DB.clients = [];
  }

  const metadataName = AUTH_SESSION.user.user_metadata && AUTH_SESSION.user.user_metadata.name;
  if(metadataName){
    DB.settings.profile = { name: metadataName, initials: initialsFor(metadataName) };
    ui.needsProfilePrompt = false;
  } else {
    ui.needsProfilePrompt = !DB.settings.profile.name;
  }
}

async function persist(){
  if(!AUTH_SESSION) return;
  ui.saving = true;
  renderSaveBit();

  const [registryResult, settingsResult] = await Promise.all([
    supabaseClient.from("registry_data").upsert({
      id: 1,
      clients: DB.clients,
      updated_at: new Date().toISOString()
    }, {onConflict:"id"}),
    supabaseClient.from("user_settings").upsert({
      user_id: AUTH_SESSION.user.id,
      data: DB.settings,
      updated_at: new Date().toISOString()
    }, {onConflict:"user_id"})
  ]);

  if(registryResult.error) console.error("Registry save failed:", registryResult.error);
  if(settingsResult.error) console.error("Settings save failed:", settingsResult.error);

  ui.saving = false;
  renderSaveBit();
}

function renderSaveBit(){
  const el = document.getElementById("savebit");
  if(!el) return;
  el.textContent = ui.saving ? "Saving…" : "All changes saved";
}

function startCloudPoll(){
  if(pollHandle) clearInterval(pollHandle);
  if(!AUTH_SESSION) return;

  pollHandle = setInterval(async ()=>{
    if(ui.clientModal || ui.addOpen || ui.saving) return;

    const { data, error } = await supabaseClient
      .from("registry_data")
      .select("clients")
      .eq("id", 1)
      .maybeSingle();

    if(!error && data && Array.isArray(data.clients)){
      DB.clients = data.clients;
      render();
    }
  }, 15000);
}

function stopCloudPoll(){
  if(pollHandle){ clearInterval(pollHandle); pollHandle = null; }
}

async function migrateLegacyLocalData(){
  // If the old app was previously used in a normal browser, offer its local data
  // to the cloud the first time. This is intentionally non-destructive.
  try{
    const legacy = localStorage.getItem(PERSONAL_KEY);
    if(!legacy || DB.clients.length) return false;
    const parsed = JSON.parse(legacy);
    if(!parsed || !Array.isArray(parsed.clients) || !parsed.clients.length) return false;

    if(confirm("I found an older local Overage Registry backup in this browser. Upload those cases to the shared cloud registry?")){
      DB.clients = parsed.clients;
      if(parsed.settings){
        DB.settings = Object.assign(defaultSettings(), parsed.settings, {
          profile: Object.assign({name:"",initials:""}, (parsed.settings||{}).profile||{})
        });
      }
      await persist();
      return true;
    }
  }catch(e){
    console.warn("Legacy local-data migration skipped:", e);
  }
  return false;
}

/* ============================== UTIL ============================== */
function uid(){ return Date.now().toString(36)+Math.random().toString(36).slice(2,8); }
function todayStr(){ return new Date().toISOString().slice(0,10); }
function nowIso(){ return new Date().toISOString(); }
function currency(n){ const num=Number(n); if(!isFinite(num)) return "$0"; return num.toLocaleString("en-US",{style:"currency",currency:"USD",maximumFractionDigits:0}); }
function addDays(dateStr, days){ const d = dateStr? new Date(dateStr+"T00:00:00") : new Date(); d.setDate(d.getDate()+days); return d.toISOString().slice(0,10); }
function daysSince(dateStr){ const d=new Date(dateStr); const diff = Date.now()-d.getTime(); return Math.floor(diff/86400000); }
function escapeHtml(s){ return String(s==null?"":s).replace(/[&<>"']/g, c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c])); }
function stateFromCounty(county){ const m = String(county||"").match(/,\s*([A-Z]{2})\s*$/); return m ? m[1] : ""; }
function initialsFor(name){ return String(name||"?").trim().split(/\s+/).slice(0,2).map(w=>w[0]).join("").toUpperCase() || "?"; }
function monthLabel(dateStr){ const d = new Date(dateStr); return d.toLocaleString("en-US",{month:"short",year:"2-digit"}); }
/* currentUserName is defined in the Supabase auth section. */

/* ---- financial calc: kept in one place so the formula is easy to change later ---- */
function calcFinancials(c){
  const est = Number(c.amount)||0;
  const companyPct = (c.companyPct!=null && c.companyPct!=="") ? Number(c.companyPct) : DB.settings.finance.defaultCompanyPct;
  const expenses = Number(c.expenses)||0;
  const fees = Number(c.fees)||0;
  const actualRecovery = c.actualRecovery!=null && c.actualRecovery!=="" ? Number(c.actualRecovery) : null;
  const estimatedProfit = Math.max(0, est*(companyPct/100) - expenses);
  const actualProfit = actualRecovery!=null ? (actualRecovery*(companyPct/100) - expenses - fees) : null;
  return { est, companyPct, expenses, fees, actualRecovery, estimatedProfit, actualProfit };
}

/* ============================== THEME ============================== */
function applyTheme(){
  document.documentElement.setAttribute("data-theme", DB.settings.themeMode==="light" ? "light" : "dark");
  if(DB.settings.themeCustom){
    const t = DB.settings.themeCustom, r = document.documentElement.style;
    r.setProperty("--accent", t.accent||"");
  } else {
    document.documentElement.style.removeProperty("--accent");
  }
}

/* ============================== CRUD ============================== */
async function addClient(data){
  const county = data.county||"";
  const who = currentUserName();
  const client = Object.assign({}, data, {
    id: uid(), archived:false,
    state: data.state || stateFromCounty(county),
    dateAdded: todayStr(),
    createdBy: who, lastModifiedBy: who, lastModified: nowIso(),
    nextFollowUp: data.nextFollowUp || addDays(todayStr(), DEFAULT_FOLLOWUP_DAYS),
    files: [],
    activity: [{date: nowIso(), text:`Case opened by ${who}.`}]
  });
  DB.clients.unshift(client);
  await persist(); render();
}
async function updateClient(id, patch){
  const who = currentUserName();
  DB.clients = DB.clients.map(c=> c.id===id ? Object.assign({},c,patch,{lastModifiedBy:who, lastModified: nowIso()}) : c);
  await persist(); render();
}
async function deleteClient(id){
  DB.clients = DB.clients.filter(c=>c.id!==id);
  await persist();
  ui.clientModal = null; render();
}
async function archiveClient(id, archived){
  const patch = { archived };
  if(archived) patch.archivedDate = todayStr(); else patch.archivedDate = null;
  const c = DB.clients.find(x=>x.id===id);
  await logActivity(c, archived ? `Case archived by ${currentUserName()}.` : `Case restored by ${currentUserName()}.`, null, null, patch);
}
async function logActivity(client, text, statusAdvance, followUpDays, extraPatch){
  const entry = {date: nowIso(), text};
  const activity = (client.activity||[]).concat([entry]);
  const patch = Object.assign({ activity }, extraPatch||{});
  if(statusAdvance) patch.status = statusAdvance;
  if(followUpDays!=null) patch.nextFollowUp = addDays(todayStr(), followUpDays);
  await updateClient(client.id, patch);
}
async function addFileRef(client, file){
  const files = (client.files||[]).concat([file]);
  await updateClient(client.id, { files });
}
async function removeFileRef(client, idx){
  const files = (client.files||[]).filter((_,i)=>i!==idx);
  await updateClient(client.id, { files });
}
async function bulkImport(rows){
  const existingKeys = new Set(DB.clients.map(c => (c.name||"").trim().toLowerCase()+"|"+(c.county||"").trim().toLowerCase()));
  const who = currentUserName();
  let added = 0, skipped = 0;
  for(const row of rows){
    const key = (row.name||"").trim().toLowerCase()+"|"+(row.county||"").trim().toLowerCase();
    if(existingKeys.has(key)){ skipped++; continue; }
    existingKeys.add(key);
    const county = row.county||"";
    DB.clients.unshift(Object.assign({
      id: uid(), archived:false, status:"New lead",
      fundType: row.fundType||"Tax sale excess funds",
      state: row.state || stateFromCounty(county),
      dateAdded: todayStr(), createdBy: who, lastModifiedBy: who, lastModified: nowIso(),
      nextFollowUp: addDays(todayStr(), DEFAULT_FOLLOWUP_DAYS), files:[],
      activity:[{date:nowIso(), text:`Case opened by ${who} (bulk import).`}]
    }, row));
    added++;
  }
  await persist();
  ui.importRows = null; ui.view="active"; render();
  alert(`Imported ${added} new lead${added===1?"":"s"}.` + (skipped ? ` Skipped ${skipped} already on file (matched by name + county).` : ""));
}

/* ============================== AUTOMATION HELPERS ============================== */
const TERMINAL_STATUSES = ["Paid out","Declined"];
function isStale(c){
  if(c.archived) return false;
  const last = (c.activity && c.activity.length) ? c.activity[c.activity.length-1].date : c.dateAdded;
  if(!last) return false;
  return daysSince(last) >= STALE_DAYS;
}
function followUpBuckets(){
  const today = todayStr();
  const active = DB.clients.filter(c=>!c.archived);
  const overdue = active.filter(c=>c.nextFollowUp && c.nextFollowUp < today);
  const dueToday = active.filter(c=>c.nextFollowUp === today);
  const overdueIds = new Set(overdue.map(c=>c.id));
  const dueTodayIds = new Set(dueToday.map(c=>c.id));
  const stale = active.filter(c=>!overdueIds.has(c.id) && !dueTodayIds.has(c.id) && isStale(c));
  return {overdue, dueToday, stale};
}
function attentionCount(){ const {overdue, dueToday, stale} = followUpBuckets(); return overdue.length + dueToday.length + stale.length; }
function creatorList(){ return Array.from(new Set(DB.clients.map(c=>c.createdBy).filter(Boolean))).sort(); }

/* ============================== CSV PARSE ============================== */
function parseCSV(text){
  const lines = text.split(/\r?\n/).filter(l=>l.trim().length);
  if(!lines.length) return [];
  const splitLine = (line) => {
    const out=[]; let cur=""; let inQ=false;
    for(let i=0;i<line.length;i++){
      const ch=line[i];
      if(ch==='"'){ inQ=!inQ; continue; }
      if(ch===',' && !inQ){ out.push(cur); cur=""; continue; }
      cur+=ch;
    }
    out.push(cur);
    return out.map(s=>s.trim());
  };
  const header = splitLine(lines[0]).map(h=>h.toLowerCase());
  const rows = [];
  for(let i=1;i<lines.length;i++){
    const cells = splitLine(lines[i]);
    const row = {};
    header.forEach((h,idx)=>{ row[h] = cells[idx]||""; });
    rows.push({
      name: row.name||"", county: row.county||"", state: row.state||"",
      fundType: row.fundtype||row["fund type"]||"", amount: row.amount||"",
      phone: row.phone||"", email: row.email||"", sourceUrl: row.sourceurl||row["source url"]||"",
      notes: row.notes||""
    });
  }
  return rows.filter(r=>r.name);
}


/* ============================== AUTH UI ============================== */
function renderAuth(){
  const signup = authMode === "signup";
  const reset = authMode === "reset";

  if(reset){
    return `
      <div class="auth-screen">
        <div class="auth-card">
          <div class="auth-brand"><div class="auth-mark">OR</div><b>Overage Registry</b></div>
          <h1>Reset your password</h1>
          <p class="auth-sub">Enter your account email and Supabase will send you a password-reset link.</p>
          <form class="auth-form" id="auth-form">
            <label class="field"><span class="lbl">Email</span><input id="auth-email" class="inp" type="email" autocomplete="email" required></label>
            <div id="auth-error" class="auth-error">${escapeHtml(authError)}</div>
            ${authMessage ? `<div class="auth-success">${escapeHtml(authMessage)}</div>` : ""}
            <button class="btn primary" type="submit">Send reset link</button>
          </form>
          <div class="auth-switch"><button class="auth-link" id="auth-back">Back to sign in</button></div>
        </div>
      </div>`;
  }

  return `
    <div class="auth-screen">
      <div class="auth-card">
        <div class="auth-brand"><div class="auth-mark">OR</div><b>Overage Registry</b></div>
        <h1>${signup ? "Create your account" : "Welcome back"}</h1>
        <p class="auth-sub">${signup ? "Create one of the accounts for your private 5-user workspace." : "Sign in to access the shared registry from any device."}</p>
        <form class="auth-form" id="auth-form">
          ${signup ? `<label class="field"><span class="lbl">Name</span><input id="auth-name" class="inp" autocomplete="name" required></label>` : ""}
          <label class="field"><span class="lbl">Email</span><input id="auth-email" class="inp" type="email" autocomplete="email" required></label>
          <label class="field"><span class="lbl">Password</span><input id="auth-password" class="inp" type="password" autocomplete="${signup?"new-password":"current-password"}" minlength="6" required></label>
          <div id="auth-error" class="auth-error">${escapeHtml(authError)}</div>
          ${authMessage ? `<div class="auth-success">${escapeHtml(authMessage)}</div>` : ""}
          <button class="btn primary" type="submit">${signup ? "Create account" : "Sign in"}</button>
        </form>
        ${!signup ? `<div class="auth-switch"><button class="auth-link" id="auth-reset">Forgot password?</button></div>` : ""}
        <div class="auth-divider"></div>
        <div class="auth-switch">
          ${signup ? `Already have an account? <button class="auth-link" id="auth-login">Sign in</button>`
                   : `Need an account? <button class="auth-link" id="auth-signup">Create one</button>`}
        </div>
      </div>
    </div>`;
}

function bindAuth(){
  const form = document.getElementById("auth-form");
  if(!form) return;

  form.onsubmit = async (e)=>{
    e.preventDefault();
    authError = "";
    authMessage = "";

    const email = document.getElementById("auth-email").value.trim();
    if(authMode === "reset"){
      const { error } = await supabaseClient.auth.resetPasswordForEmail(email, {
        redirectTo: window.location.origin + window.location.pathname
      });
      if(error) authError = error.message;
      else authMessage = "Check your email for the password reset link.";
      render();
      return;
    }

    const password = document.getElementById("auth-password").value;
    if(authMode === "signup"){
      const name = document.getElementById("auth-name").value.trim();
      const { data, error } = await supabaseClient.auth.signUp({
        email, password,
        options:{ data:{ name, initials:initialsFor(name) } }
      });
      if(error){ authError = error.message; render(); return; }

      if(data.session){
        AUTH_SESSION = data.session;
      }else{
        authMessage = "Account created. Check your email to confirm the account, then sign in.";
        render();
      }
    }else{
      const { data, error } = await supabaseClient.auth.signInWithPassword({email, password});
      if(error){ authError = error.message; render(); return; }
      AUTH_SESSION = data.session;
      authMessage = "";
      authError = "";
      await finishAuthenticatedBoot();
    }
  };

  const signup = document.getElementById("auth-signup");
  if(signup) signup.onclick = ()=>{ authMode="signup"; authError=""; authMessage=""; render(); };

  const login = document.getElementById("auth-login");
  if(login) login.onclick = ()=>{ authMode="login"; authError=""; authMessage=""; render(); };

  const reset = document.getElementById("auth-reset");
  if(reset) reset.onclick = ()=>{ authMode="reset"; authError=""; authMessage=""; render(); };

  const back = document.getElementById("auth-back");
  if(back) back.onclick = ()=>{ authMode="login"; authError=""; authMessage=""; render(); };
}

async function finishAuthenticatedBoot(){
  ui.loading = true;
  render();
  await loadDB();
  await migrateLegacyLocalData();
  ui.loading = false;
  render();
  startCloudPoll();
}

/* ============================== RENDER ROOT ============================== */
function render(){
  applyTheme();
  const app = document.getElementById("app");
  if(!AUTH_READY || ui.loading){
    app.innerHTML = `<div class="loading-wrap">LOADING OVRAGE REGISTRY…</div>`;
    return;
  }
  if(!AUTH_SESSION){
    app.innerHTML = renderAuth();
    bindAuth();
    return;
  }
  app.innerHTML = renderShell();
  bindShell();
  renderSaveBit();
  requestAnimationFrame(()=>{ if(ui.view==="dashboard") drawDashboardCharts(); if(ui.view==="reports") drawReportsCharts(); });
}

function renderShell(){
  const attn = attentionCount();
  const activeCount = DB.clients.filter(c=>!c.archived).length;
  const archivedCount = DB.clients.filter(c=>c.archived).length;
  const collapsed = DB.settings.sidebarCollapsed;
  return `
  <div class="sidebar ${collapsed?"collapsed":""} ${ui.mobileNavOpen?"mobile-open":""}">
    <div class="brand">
      <div class="brand-mark">OR</div>
      <div class="brand-text">Overage Registry</div>
    </div>
    <div class="navgroup">
      ${navBtn("dashboard","Dashboard","dashboard", attn)}
      ${navBtn("active","Active cases","active", activeCount)}
      ${navBtn("archived","Archived cases","archive")}
      ${navBtn("counties","Counties &amp; forms","county")}
      ${navBtn("import","Import leads","import")}
      ${navBtn("files","Files","files")}
      ${navBtn("reports","Reports","reports")}
      ${navBtn("settings","Settings","settings")}
    </div>
    <div class="sidefoot">
      <button class="collapse-btn" id="btn-collapse" title="Collapse sidebar">${ICONS.menu}</button>
      <div class="sync-pill"><span class="dot ${AUTH_SESSION?"":"off"}"></span><span class="sidefoot-text">${AUTH_SESSION ? "Cloud synced" : "Signed out"}</span></div>
      <div class="savebit sidefoot-text" id="savebit">All changes saved</div>
    </div>
  </div>
  <div class="main-wrap">
    <div class="topbar">
      <button class="hamburger" id="btn-hamburger">${ICONS.menu}</button>
      <div class="globalsearch">${ICONS.search}<input id="global-search" placeholder="Search clients, counties, status, creator, notes…" value="${escapeHtml(ui.search)}"/></div>
      <div class="topbar-right">
        <div class="theme-toggle">
          <button data-theme-mode="dark" class="${DB.settings.themeMode!=="light"?"active":""}">Dark</button>
          <button data-theme-mode="light" class="${DB.settings.themeMode==="light"?"active":""}">Light</button>
        </div>
        <div class="profile-chip" title="${escapeHtml(currentUserEmail())}">
          <div class="avatar">${escapeHtml(initialsFor(currentUserName()))}</div>
          <span>${escapeHtml(currentUserName())}</span>
          <span class="account-email">${escapeHtml(currentUserEmail())}</span>
        </div>
        <button class="btn sm ghost" id="btn-logout">Log out</button>
      </div>
    </div>
    <div class="main">
      ${ui.needsProfilePrompt ? renderProfilePrompt() : ""}
      ${renderView()}
    </div>
  </div>
  ${ui.clientModal ? renderClientModal(ui.clientModal) : ""}
  ${ui.addOpen ? renderAddModal() : ""}
  `;
}
function renderView(){
  if(ui.search.trim()) return renderSearchResults();
  switch(ui.view){
    case "dashboard": return renderDashboard();
    case "active": return renderCaseList(false);
    case "archived": return renderCaseList(true);
    case "counties": return renderCounties();
    case "import": return renderImport();
    case "files": return renderFiles();
    case "reports": return renderReports();
    case "settings": return renderSettings();
    default: return renderDashboard();
  }
}
function navBtn(key, label, icon, badge){
  return `<button class="navbtn ${ui.view===key && !ui.search?"active":""}" data-nav="${key}">${ICONS[icon]||""}<span class="navlabel">${label}</span>${badge ? `<span class="navbadge">${badge}</span>` : ""}</button>`;
}
function renderProfilePrompt(){
  return `<div class="card" style="border-color:var(--accent);">
    <h3>Who's using this registry?</h3>
    <p class="subtle">Set a name so new cases record who created and last touched them. This is a display name only — not a password-protected account.</p>
    <div style="display:flex;gap:8px;margin-top:8px;align-items:flex-end;flex-wrap:wrap;">
      <label class="field" style="max-width:240px;"><span class="lbl">Your name</span><input id="profile-name-inline" class="inp" placeholder="e.g. Holden"/></label>
      <button id="profile-name-save" class="btn primary">Save</button>
    </div>
  </div>`;
}

/* ---------- Dashboard ---------- */
function renderDashboard(){
  const active = DB.clients.filter(c=>!c.archived);
  const archived = DB.clients.filter(c=>c.archived);
  let potential=0, actualRecovery=0, estProfit=0, actualProfit=0;
  DB.clients.forEach(c=>{
    const f = calcFinancials(c);
    potential += f.est; estProfit += f.estimatedProfit;
    if(f.actualRecovery!=null){ actualRecovery += f.actualRecovery; actualProfit += (f.actualProfit||0); }
  });
  const avgCaseValue = DB.clients.length ? (potential/DB.clients.length) : 0;
  const {overdue, dueToday, stale} = followUpBuckets();
  const recent = DB.clients.slice().sort((a,b)=>(b.lastModified||"").localeCompare(a.lastModified||"")).slice(0,6);
  const greetName = DB.settings.profile.name ? DB.settings.profile.name.split(" ")[0] : "";
  const hour = new Date().getHours();
  const greet = hour<12?"Good morning":hour<18?"Good afternoon":"Good evening";

  return `
  <div class="eyebrow">Docket</div>
  <h1 class="title">${greet}${greetName?", "+escapeHtml(greetName):""}</h1>
  <p class="pagesub">Here's what's happening with your cases.</p>
  <div class="grid4" style="margin-bottom:14px;">
    ${metric("Potential recovery", currency(potential))}
    ${metric("Estimated profit", currency(estProfit))}
    ${metric("Actual profit", currency(actualProfit))}
    ${metric("Active cases", active.length)}
  </div>
  <div class="grid2" style="margin-bottom:4px;">
    <div class="chartbox"><div class="eyebrow">Cases added — last 6 months</div><canvas id="chart-cases"></canvas></div>
    <div class="chartbox"><div class="eyebrow">Case status breakdown</div><canvas id="chart-status"></canvas></div>
  </div>
  <div class="card">
    <h3>Needs follow-up</h3>
    <p class="subtle" style="margin:2px 0 0;">Auto-flagged: overdue by date, due today, or no activity logged in ${STALE_DAYS}+ days.</p>
    ${overdue.length===0 && dueToday.length===0 && stale.length===0
      ? `<p class="subtle" style="margin:10px 0 0;">Nothing needs attention right now.</p>`
      : `<div style="display:flex;flex-direction:column;gap:8px;margin-top:10px;">
          ${overdue.map(c=>followRow(c,"overdue")).join("")}
          ${dueToday.map(c=>followRow(c,"today")).join("")}
          ${stale.map(c=>followRow(c,"stale")).join("")}
        </div>`}
  </div>
  <div class="card">
    <h3>Recent cases</h3>
    ${recent.length===0 ? `<p class="subtle" style="margin:6px 0 0;">No cases yet — add one from Active cases, or bulk-import a list.</p>` :
    `<div style="margin-top:4px;">
      <table><thead><tr><th>Client</th><th>County</th><th>Status</th><th>Recovery</th><th>Profit</th><th>Created by</th><th>Updated</th></tr></thead>
      <tbody>${recent.map(c=>{
        const f = calcFinancials(c);
        return `<tr class="row" data-open="${c.id}">
          <td style="font-weight:600;">${escapeHtml(c.name||"Unnamed")}</td>
          <td class="subtle">${escapeHtml(c.county||"—")}</td>
          <td>${stamp(c.status)}</td>
          <td style="font-family:var(--font-mono);">${currency(f.est)}</td>
          <td style="font-family:var(--font-mono);">${currency(f.actualProfit!=null?f.actualProfit:f.estimatedProfit)}</td>
          <td class="subtle">${escapeHtml(c.createdBy||"—")}</td>
          <td class="subtle">${c.lastModified?daysSince(c.lastModified)+"d ago":"—"}</td>
        </tr>`;}).join("")}</tbody></table>
    </div>`}
  </div>`;
}
function followRow(c, kind){
  const label = kind==="overdue"?"OVERDUE":kind==="today"?"DUE TODAY":"STALE";
  const dateLabel = kind==="stale" ? `${daysSince((c.activity&&c.activity.length)?c.activity[c.activity.length-1].date:c.dateAdded)}d quiet` : (c.nextFollowUp||"");
  return `<div class="row" data-open="${c.id}" style="display:flex;justify-content:space-between;align-items:center;cursor:pointer;">
    <div><span class="flag ${kind}">${label}</span>
    <span style="margin-left:8px;font-weight:600;">${escapeHtml(c.name||"Unnamed")}</span>
    <span class="subtle"> · ${escapeHtml(c.county||"—")}</span></div>
    <span class="subtle" style="font-family:var(--font-mono);">${dateLabel}</span>
  </div>`;
}
function metric(label,value){ return `<div class="metric"><div class="label">${label.toUpperCase()}</div><div class="value">${value}</div></div>`; }
const STATUS_COLORS = {
  "New lead":"#5B8CFF","Skip traced":"#7C9CFF","Contacted":"#E8A33D","Docs sent":"#E8A33D",
  "Signed":"#2FBF71","Filed with county":"#2FBF71","Paid out":"#1E9C57","Declined":"#F0554D"
};
function stamp(status){
  const c = STATUS_COLORS[status]||"#9AA1AE";
  return `<span class="badge" style="background:${c}22;color:${c};">${escapeHtml(status||"New lead")}</span>`;
}
function chartColors(n){ const base=["#5B8CFF","#2FBF71","#E8A33D","#F0554D","#7C9CFF","#9AA1AE","#1E9C57"]; const out=[]; for(let i=0;i<n;i++) out.push(base[i%base.length]); return out; }
function destroyChart(id){ if(charts[id]){ charts[id].destroy(); delete charts[id]; } }
function chartTextColor(){ return getComputedStyle(document.documentElement).getPropertyValue("--text-dim").trim() || "#9AA1AE"; }
function chartGridColor(){ return getComputedStyle(document.documentElement).getPropertyValue("--border").trim() || "#232733"; }

function drawDashboardCharts(){
  if(typeof Chart==="undefined") return;
  const casesCanvas = document.getElementById("chart-cases");
  const statusCanvas = document.getElementById("chart-status");
  if(casesCanvas){
    destroyChart("cases");
    const months = [];
    for(let i=5;i>=0;i--){ const d=new Date(); d.setMonth(d.getMonth()-i); months.push(d); }
    const labels = months.map(d=>d.toLocaleString("en-US",{month:"short"}));
    const counts = months.map(d=>{
      const ym = d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0");
      return DB.clients.filter(c=>(c.dateAdded||"").startsWith(ym)).length;
    });
    charts.cases = new Chart(casesCanvas, { type:"bar", data:{ labels, datasets:[{ data:counts, backgroundColor:"#5B8CFF", borderRadius:4, maxBarThickness:28 }] },
      options: baseChartOpts(false) });
  }
  if(statusCanvas){
    destroyChart("status");
    const counts = STATUSES.map(s=>DB.clients.filter(c=>!c.archived && c.status===s).length);
    const nonzero = STATUSES.map((s,i)=>({s,i})).filter(x=>counts[x.i]>0);
    charts.status = new Chart(statusCanvas, { type:"doughnut",
      data:{ labels: nonzero.map(x=>x.s), datasets:[{ data: nonzero.map(x=>counts[x.i]), backgroundColor: nonzero.map(x=>STATUS_COLORS[x.s]), borderWidth:0 }] },
      options:{ plugins:{ legend:{ position:"right", labels:{ color:chartTextColor(), boxWidth:10, font:{size:11} } } }, cutout:"62%" } });
  }
}
function baseChartOpts(showLegend){
  return { plugins:{ legend:{ display:!!showLegend, labels:{color:chartTextColor()} } },
    scales:{ x:{ ticks:{color:chartTextColor()}, grid:{display:false} }, y:{ ticks:{color:chartTextColor(), precision:0}, grid:{color:chartGridColor()} } } };
}

/* ---------- Search ---------- */
function renderSearchResults(){
  const q = ui.search.toLowerCase();
  const list = DB.clients.filter(c=>{
    return (c.name||"").toLowerCase().includes(q) || (c.county||"").toLowerCase().includes(q) ||
      (c.status||"").toLowerCase().includes(q) || (c.createdBy||"").toLowerCase().includes(q) ||
      (c.notes||"").toLowerCase().includes(q) || (c.tags||[]).join(" ").toLowerCase().includes(q);
  });
  return `<div class="eyebrow">Search</div><h1 class="title">Results for "${escapeHtml(ui.search)}"</h1>
  <div class="card" style="padding:0;">${list.length===0?`<p class="subtle" style="margin:0;padding:18px;">No matches across clients, counties, status, creator, tags, or notes.</p>`:
  `<table><thead><tr><th>Name</th><th>County</th><th>Status</th><th>Created by</th><th></th></tr></thead><tbody>
  ${list.map(c=>`<tr class="row" data-open="${c.id}"><td style="font-weight:600;">${escapeHtml(c.name||"Unnamed")}</td><td class="subtle">${escapeHtml(c.county||"—")}</td><td>${stamp(c.status)}</td><td class="subtle">${escapeHtml(c.createdBy||"—")}</td><td>${c.archived?`<span class="tag">Archived</span>`:""}</td></tr>`).join("")}
  </tbody></table>`}</div>`;
}

/* ---------- Active / Archived case list ---------- */
function filteredSorted(archivedView){
  let list = DB.clients.filter(c=>!!c.archived === archivedView);
  if(ui.statusFilter!=="All") list = list.filter(c=>c.status===ui.statusFilter);
  if(ui.countyFilter!=="All") list = list.filter(c=>c.county===ui.countyFilter);
  if(ui.creatorFilter!=="All") list = list.filter(c=>c.createdBy===ui.creatorFilter);
  list = list.slice().sort((a,b)=>{
    if(ui.sortBy==="amount") return (Number(b.amount)||0)-(Number(a.amount)||0);
    if(ui.sortBy==="followup") return (a.nextFollowUp||"9999").localeCompare(b.nextFollowUp||"9999");
    return (b.dateAdded||"").localeCompare(a.dateAdded||"");
  });
  return list;
}
function renderCaseList(archivedView){
  const list = filteredSorted(archivedView);
  return `
  <div class="eyebrow">${archivedView?"Archive":"Case files"}</div>
  <h1 class="title">${archivedView?"Archived cases":"Active cases"}</h1>
  <p class="pagesub">${archivedView?"Closed cases stay here permanently with full history — nothing is deleted when archived.":"Everything currently open, from new lead through payout."}</p>
  <div class="filterbar">
    <select id="status-filter" class="inp"><option ${ui.statusFilter==="All"?"selected":""}>All statuses</option>${STATUSES.map(s=>`<option ${ui.statusFilter===s?"selected":""}>${s}</option>`).join("")}</select>
    <select id="county-filter" class="inp"><option value="All" ${ui.countyFilter==="All"?"selected":""}>All counties</option>${Array.from(new Set(DB.clients.map(c=>c.county).filter(Boolean))).map(cn=>`<option ${ui.countyFilter===cn?"selected":""}>${escapeHtml(cn)}</option>`).join("")}</select>
    <select id="creator-filter" class="inp"><option value="All" ${ui.creatorFilter==="All"?"selected":""}>All creators</option>${creatorList().map(cr=>`<option ${ui.creatorFilter===cr?"selected":""}>${escapeHtml(cr)}</option>`).join("")}</select>
    <select id="sort-by" class="inp">
      <option value="dateAdded" ${ui.sortBy==="dateAdded"?"selected":""}>Newest first</option>
      <option value="amount" ${ui.sortBy==="amount"?"selected":""}>Highest amount</option>
      <option value="followup" ${ui.sortBy==="followup"?"selected":""}>Follow-up date</option>
    </select>
    ${(ui.statusFilter!=="All"||ui.countyFilter!=="All"||ui.creatorFilter!=="All") ? `<button id="clear-filters" class="btn ghost sm">Clear filters</button>` : ""}
    ${!archivedView ? `<button id="btn-add" class="btn primary" style="margin-left:auto;">+ Add client</button>` : ""}
  </div>
  <div class="card" style="padding:0;">
    ${list.length===0 ? `<p class="empty">No matching cases.</p>` : `
    <table>
      <thead><tr><th>Name</th><th>County / state</th><th>Amount</th><th>Status</th><th>Created by</th><th>${archivedView?"Archived":"Follow-up"}</th><th>Quick actions</th></tr></thead>
      <tbody>
        ${list.map(c=>{
          const today = todayStr();
          const fu = archivedView ? (c.archivedDate||"—") : (c.nextFollowUp ? (c.nextFollowUp < today ? `<span class="flag overdue">${c.nextFollowUp}</span>` : c.nextFollowUp===today ? `<span class="flag today">${c.nextFollowUp}</span>` : c.nextFollowUp) : "—");
          return `<tr class="row" data-open="${c.id}">
            <td><div style="font-weight:600;">${escapeHtml(c.name||"Unnamed")}</div>${(c.tags||[]).map(t=>`<span class="tag">${escapeHtml(t)}</span>`).join("")}</td>
            <td class="subtle">${escapeHtml(c.county||"—")}${c.state?` (${escapeHtml(c.state)})`:""}</td>
            <td style="font-family:var(--font-mono);">${currency(c.amount)}</td>
            <td>${stamp(c.status)}</td>
            <td class="subtle">${escapeHtml(c.createdBy||"—")}</td>
            <td>${fu}</td>
            <td onclick="event.stopPropagation()">
              ${c.phone ? `<a class="btn sm ghost" href="tel:${escapeHtml(c.phone)}" style="margin-right:4px;">Call</a>`:""}
              ${c.email ? `<a class="btn sm ghost" href="mailto:${escapeHtml(c.email)}">Email</a>`:""}
            </td>
          </tr>`;
        }).join("")}
      </tbody>
    </table>`}
  </div>`;
}

/* ---------- Add / Edit modal ---------- */
function fieldHtml(id, label, value, type){
  type = type||"text";
  return `<label class="field"><span class="lbl">${label}</span><input id="${id}" class="inp" type="${type}" value="${escapeHtml(value==null?"":value)}" /></label>`;
}
function selectHtml(id, label, options, value){
  return `<label class="field"><span class="lbl">${label}</span><select id="${id}" class="inp"><option value="">Select…</option>${options.map(o=>`<option ${o===value?"selected":""}>${o}</option>`).join("")}</select></label>`;
}
function renderAddModal(){
  return `<div class="modal-backdrop" id="add-backdrop">
    <div class="modal">
      <div class="modal-head"><h2 style="margin:0;font-size:17px;">Open a new case</h2><button class="close-x" id="add-close">×</button></div>
      <div class="modal-body">
      <p class="subtle" style="margin:-6px 0 12px;">Created by <b>${escapeHtml(currentUserName())}</b>. A follow-up reminder is set automatically for ${DEFAULT_FOLLOWUP_DAYS} days out.</p>
      <div class="grid2">
        ${fieldHtml("f-name","Client name","")}
        ${selectHtml("f-county","County / office", COUNTIES.map(c=>c.name), "")}
        ${selectHtml("f-fundtype","Fund type", FUND_TYPES, "Tax sale excess funds")}
        ${fieldHtml("f-amount","Estimated recovery ($)","","number")}
        ${fieldHtml("f-phone","Phone (if known)","")}
        ${fieldHtml("f-email","Email (if known)","")}
        ${fieldHtml("f-source","Source list URL","")}
        ${fieldHtml("f-tags","Tags (comma separated)","")}
      </div>
      <div style="margin-top:12px;"><label class="field"><span class="lbl">Notes</span><textarea id="f-notes" class="inp" style="min-height:56px;resize:vertical;"></textarea></label></div>
      <div id="add-error" style="color:var(--neg);font-size:12.5px;margin-top:8px;"></div>
      <button id="add-submit" class="btn primary" style="margin-top:14px;">Open case file</button>
      </div>
    </div>
  </div>`;
}
function renderClientModal(id){
  const c = DB.clients.find(x=>x.id===id);
  if(!c) return "";
  const county = countyByName(c.county);
  const lastActivity = (c.activity && c.activity.length) ? c.activity[c.activity.length-1] : null;
  const f = calcFinancials(c);
  const tab = ui.clientTab;
  const tabBtn = (key,label)=>`<button class="tabbtn ${tab===key?"active":""}" data-tab="${key}">${label}</button>`;

  let body = "";
  if(tab==="overview"){
    body = `
      <div class="grid2" style="margin-top:14px;">
        ${fieldHtml("e-name","Client name", c.name)}
        ${selectHtml("e-status","Status", STATUSES, c.status)}
        ${selectHtml("e-county","County / office", COUNTIES.map(x=>x.name), c.county)}
        ${selectHtml("e-fundtype","Fund type", FUND_TYPES, c.fundType)}
        ${fieldHtml("e-phone","Phone", c.phone)}
        ${fieldHtml("e-email","Email", c.email)}
        ${fieldHtml("e-source","Source list URL", c.sourceUrl)}
        ${fieldHtml("e-tags","Tags (comma separated)", (c.tags||[]).join(", "))}
        ${fieldHtml("e-followup","Next follow-up date", c.nextFollowUp, "date")}
      </div>
      <div class="stat-inline" style="margin-top:12px;">
        <div>Created by <b>${escapeHtml(c.createdBy||"—")}</b> · ${c.dateAdded||""}</div>
        <div>Last touched by <b>${escapeHtml(c.lastModifiedBy||"—")}</b>${lastActivity?` · ${daysSince(lastActivity.date)}d ago`:""}</div>
      </div>
      <div style="margin-top:14px;">
        <div class="eyebrow">Quick follow-up</div>
        <div class="quicknote">
          <button class="btn sm ghost" data-fu="3">+3 days</button>
          <button class="btn sm ghost" data-fu="7">+7 days</button>
          <button class="btn sm ghost" data-fu="14">+14 days</button>
          ${c.phone ? `<a class="btn sm ghost" href="tel:${escapeHtml(c.phone)}">Call</a>`:""}
          ${c.email ? `<a class="btn sm ghost" href="mailto:${escapeHtml(c.email)}">Email</a>`:""}
        </div>
        <div class="eyebrow" style="margin-top:6px;">Log &amp; auto-advance</div>
        <p class="subtle" style="margin:2px 0 6px;">Each logs the contact, moves the status, and schedules the next reminder.</p>
        <div class="quicknote">
          <button class="btn sm" data-log="Called — left voicemail." data-advance="Contacted" data-fudays="3">Voicemail (+3d)</button>
          <button class="btn sm" data-log="Called and spoke with client." data-advance="Contacted" data-fudays="5">Spoke w/ client (+5d)</button>
          <button class="btn sm" data-log="Docs sent to client." data-advance="Docs sent" data-fudays="5">Docs sent (+5d)</button>
          <button class="btn sm" data-log="Signed and filed with the county." data-advance="Filed with county" data-fudays="30">Filed with county (+30d)</button>
          <button class="btn sm" data-log="Payment received — case closed." data-advance="Paid out" data-fudays="">Payment received</button>
        </div>
      </div>`;
  } else if(tab==="financials"){
    body = `
      <div class="grid2" style="margin-top:14px;">
        ${fieldHtml("e-amount","Estimated recovery ($)", c.amount, "number")}
        ${fieldHtml("e-companypct","Company % of recovery", c.companyPct!=null?c.companyPct:DB.settings.finance.defaultCompanyPct, "number")}
        ${fieldHtml("e-clientpct","Client % (informational)", c.clientPct, "number")}
        ${fieldHtml("e-attorneypct","Attorney % (informational)", c.attorneyPct, "number")}
        ${fieldHtml("e-expenses","Expenses ($)", c.expenses, "number")}
        ${fieldHtml("e-fees","Filing/attorney fees ($)", c.fees, "number")}
        ${fieldHtml("e-actualrecovery","Actual recovery ($, once paid)", c.actualRecovery, "number")}
      </div>
      <div class="grid3" style="margin-top:14px;">
        ${metric("Estimated profit", currency(f.estimatedProfit))}
        ${metric("Actual profit", f.actualProfit!=null?currency(f.actualProfit):"—")}
        ${metric("Company %", (f.companyPct||0)+"%")}
      </div>
      <p class="disclaimer-mini">Profit = recovery × company % − expenses − fees. Defaults live in Settings → Financial defaults and can be overridden per case.</p>`;
  } else if(tab==="county"){
    body = county ? `
      <div class="card" style="margin-top:14px;">
        <h3>${escapeHtml(county.name)}</h3>
        <span class="badge" style="background:${county.poaAccepted===false?"var(--neg)22":county.poaAccepted?"var(--pos)22":"var(--text-faint)22"};color:${county.poaAccepted===false?"var(--neg)":county.poaAccepted?"var(--pos)":"var(--text-dim)"};">
          ${county.poaAccepted===false?"POA NOT ACCEPTED":county.poaAccepted?"POA ACCEPTED":"UNVERIFIED"}</span>
        <p class="subtle" style="margin-top:8px;">${escapeHtml(county.summary)}</p>
        <p class="subtle"><b>Requirements:</b> ${escapeHtml(county.requirements)}</p>
        <p class="subtle"><b>Filing:</b> ${escapeHtml(county.filingInstructions)}</p>
        <p class="subtle"><b>Deadline:</b> ${escapeHtml(county.deadline)}</p>
        ${county.rulesUrl ? `<a class="btn sm" href="${escapeHtml(county.rulesUrl)}" target="_blank" rel="noopener">View county rules ${ICONS.external}</a>` : ""}
        ${(county.forms||[]).map(fm=>`<a class="btn sm" style="margin-left:6px;" href="${escapeHtml(fm.url)}" target="_blank" rel="noopener">${escapeHtml(fm.name)} ${ICONS.external}</a>`).join("")}
      </div>` : `<p class="subtle" style="margin-top:14px;">Set a county on the Overview tab to see its filing requirements here.</p>`;
  } else if(tab==="activity"){
    body = `<div style="margin-top:14px;max-height:320px;overflow:auto;">
      ${(c.activity||[]).slice().reverse().map(a=>`<div class="activity-item"><div class="activity-date">${new Date(a.date).toLocaleString()}</div>${escapeHtml(a.text)}</div>`).join("") || `<p class="subtle">No activity yet.</p>`}
    </div>`;
  } else if(tab==="files"){
    body = `<div style="margin-top:14px;">
      <p class="subtle">Attach references to documents — court filings, county forms, IDs, correspondence. This stores names, types, and links/notes here in the registry (not binary file storage), so keep the actual files in your own drive and link or note where they live.</p>
      <div class="filelist" id="filelist-wrap">
        ${(c.files||[]).map((fl,idx)=>`<div class="filerow"><div><b>${escapeHtml(fl.name)}</b> <span class="tag">${escapeHtml(fl.category||"Other")}</span>${fl.note?`<div class="subtle">${escapeHtml(fl.note)}</div>`:""}</div><button class="btn sm ghost" data-rmfile="${idx}">Remove</button></div>`).join("") || `<p class="subtle">No files logged yet.</p>`}
      </div>
      <div class="grid2" style="margin-top:12px;">
        ${fieldHtml("nf-name","File / document name","")}
        ${selectHtml("nf-cat","Category", ["Court document","County form","Contract","Identification","Correspondence","Receipt","Other"], "Other")}
      </div>
      <label class="field" style="margin-top:8px;"><span class="lbl">Note or link</span><input id="nf-note" class="inp" placeholder="Where it's stored, or a link"/></label>
      <button id="btn-addfile" class="btn ghost sm" style="margin-top:8px;">+ Log file</button>
    </div>`;
  } else if(tab==="notes"){
    body = `<div style="margin-top:14px;"><label class="field"><span class="lbl">Notes</span><textarea id="e-notes" class="inp" style="min-height:140px;resize:vertical;">${escapeHtml(c.notes||"")}</textarea></label></div>`;
  }

  return `<div class="modal-backdrop" id="client-backdrop">
    <div class="modal" style="max-width:760px;">
      <div class="modal-head">
        <div><div class="eyebrow">CASE FILE · ${c.archived?"ARCHIVED":"ACTIVE"}</div>
        <h2 style="margin:2px 0 0;font-size:19px;">${escapeHtml(c.name||"Unnamed")}</h2></div>
        <button class="close-x" id="client-close">×</button>
      </div>
      <div style="padding:6px 22px 0;">${stamp(c.status)}</div>
      <div class="tabs">
        ${tabBtn("overview","Overview")}${tabBtn("financials","Financials")}${tabBtn("county","County")}${tabBtn("activity","Activity")}${tabBtn("files","Files")}${tabBtn("notes","Notes")}
      </div>
      <div class="modal-body tabpanel">
        ${body}
        <div style="display:flex;gap:8px;margin-top:20px;flex-wrap:wrap;">
          <button id="client-save" class="btn primary">Save changes</button>
          ${c.archived ? `<button id="client-restore" class="btn ghost">Restore case</button>` : `<button id="client-archive" class="btn ghost">Archive case</button>`}
          <button id="client-delete" class="btn danger">Delete permanently</button>
        </div>
      </div>
    </div>
  </div>`;
}

